def Normal(z,S,P):
    if z[12] > 1:
        S.append([P*0.25,"BS"])
        P = P*(0.75)
    if z[11] > 1:
        S.append([P*1/3,"C"])
        P = P*(2/3)
    S.append([P,"F"])
    return(S)
    

def Action_Bowser(z): #z = Stats
    S = []
    P = 1
    if 10*z[0] - (100/99)*z[4] >= 25:
        S.append([0.75, "H"])
        P = P*(0.25)
    if z[8] == False:
        if z[9] == 3:
            S.append([P*0.15,"S"])
            P = P*(0.85)
        if z[9] > 3:
            S.append([P*0.75,"S"])
            P = P*(0.25)
    if z[5] < 3:
        return([[1,"F"]])
    if z[10] < 3:
        if z[15] or z[5] > 8:
            return(Normal(z,S,P))
        return([P,"F"])
    if z[10] > 5:
        S.append([P*2/3,"W"])
        S.append([P*1/3,"F"])
        return(S)
    if z[1]:
        S.append([P*2/3,"W"])
        S.append([P*1/3,"F"])
        return(S)
    S.append([P*0.18,"W"])
    if z[15] or z[5] > 8:
        p = P*0.09
        P = P*(0.73)
        if z[12] > 1:
            S.append([P*0.25,"BS"])
            P = P*(0.75)
        if z[11] > 1:
            S.append([P*1/3,"C"])
            P = P*(2/3)
        S.append([P+p,"F"])
    else:
        S.append([P*0.82,"F"])
    return(S)

def Action_Mario(z):
    if z[17] == 1: #0 LS Fight
        if z[5] in (1,2,5,8):
            return([[1, "Ch"]])
        elif z[5] == 3:
            return([[1, "JJ"]])
        elif z[5] in (4,7):
            return([[1, "RG"]])
        elif z[5] == 6:
            return([[1, "Beam"]])
        elif z[5] == 9:
            S = []
            S.append([0.002,"PB 6"])
            S.append([0.127,"PB 5"])
            S.append([0.377,"PB 4"])
            S.append([0.494,"PB 3"])
            return(S)
        elif z[5] > 6 and z[8]:
            return([[1, "Beam"]])
        return([[1, "SS"]])
    elif z[17] == 2: #Wave Delay AND >= 1 LS Fight
        if z[5] in (1,2,5,6,9):
            return([[1,"Ch"]])
        elif z[5] == 3:
            return([[1, "JJ"]])
        elif z[5] in (4,8):
            return([[1, "RG"]])
        elif z[5] == 7:
            return([[1, "Beam"]])
        elif z[5] == 10:
            S = []
            S.append([0.129,"PB 5"])
            S.append([0.377,"PB 4"])
            S.append([0.494,"PB 3"])
            return(S)
        elif z[5] > 7 and z[8]:
            return([[1, "Beam"]])
        return([[1, "SS"]])
    
    
    
    else: # >= 1 LS Fight, no Wave Delay
        if z[5] in (1,2,5,6,8):
            return([[1,"Ch"]])
        elif z[5] == 3:
            return([[1, "JJ"]])
        elif z[5] in (4,7):
            return([[1, "RG"]])
        elif z[5] > 8 and z[8]:
            return([[1, "Beam"]])
        elif z[5] == 10:
            S = []
            S.append([0.129,"PB 5"])
            S.append([0.377,"PB 4"])
            S.append([0.494,"PB 3"])
            return(S)
        return([[1, "SS"]])
    

def Action_Partner(z):
    if z[5] == 1:
        return([[1,"CNA"]])
    if z[5] > 9:
        return([[1,"SF"]])
    return([[1,"DN"]])

def Action_Inbetween(z):
    S = []
    if z[3] > 0:
        S.append([1, "No Hit"])
        return(S)
    if z[2] > 0: #the case doesnt apply here, but Cloud Nine and Closecall can stack (CN or (CC or No CC))
        S.append([0.5,"CN"])
        S.append([0.5,"Hit"])
        return(S)
    if z[0] < 6:
        S.append([0.7, "Hit"])
        S.append([0.3, "No Hit"])
        return(S)
    S.append([1, "Hit"])
    return(S)


def Stat_Change(S,z):
    z_new = [x for x in z]
    Last_Action = S[-1][1]
    
    ### Mario Action Change
    
    if Last_Action == "Ch":
        z_new[1] = True
    elif Last_Action == "RG":
        z_new[3] = 2
    elif Last_Action == "Beam":
        z_new[8] = False
    elif Last_Action == "PB 6":
        z_new[4] += -75
    elif Last_Action == "PB 5":
        if z[17]:
            z_new[4] += -65
        else:
            z_new[4] += -80
        z_new[1] = False
    elif Last_Action == "PB 4":
        if z[17]:
            z_new[4] += -54
        else:
            z_new[4] += -66
        z_new[1] = False
    elif Last_Action == "PB 3":
        if z[17]:
            z_new[4] += -42
        else:
            z_new[4] += -51
        z_new[1] = False
    elif Last_Action == "SS":
        z_new[4] += -7
    
    ### Partner Action Change
    
    elif Last_Action == "CNA":
        z_new[2] = 4
    elif Last_Action == "SF":
        if z_new[8] == 0:
            z_new[4] += -2
    
    ### Bowser Action State (Inbetween during sections)
    
    Former_Action = S[-2][1]
    
    
    if Former_Action == "H":
        z_new[4] += 30
        z_new[6] += -1
        z_new[7] = 0
        if z_new[6] < 2:
            z_new[15] = False
        
    elif Former_Action == "S":
        z_new[8] = True
        z_new[9] = 0
        
    elif Former_Action == "W":
        z_new[10] = 0
        z_new[16] = True
        if Last_Action == "Hit":
            z_new[0] += -6
            z_new[1] = False
            if z_new[5] < 10:
                z_new[15] = False
    
    
    elif Former_Action == "BS":
        z_new[12] = 0
        if Last_Action == "Hit":
            if z_new[8]:
                z_new[0] += -15
            else:
                z_new[0] += -7
    
    elif Former_Action == "C":
        z_new[11] = 0
        if Last_Action == "Hit":
            if z_new[8]:
                z_new[0] += -15
            else:
                z_new[0] += -7
    
    elif Former_Action == "F":
        if Last_Action == "Hit":
            if z_new[8]:
                z_new[0] += -19
            else:
                z_new[0] += -9
    
    ## update Turn ##
            
    if z_new[5] > 18:
        z_new[15] = False
    if z_new[14] == 2:
        z_new[14] = -1
        if z_new[0] < 1:
            z_new[0] = 10
            z_new[13] += 1
        for i in (5,7,9,10,11,12):
            z_new[i] += 1
        if z_new[4] > 99:
            z_new[4] = 99
        for i in (2,3):
            z_new[i] = max(0,z_new[i]-1)
    if z_new[13] > 5:
        z_new[15] = False
    if z[5] == 4:
        if Former_Action != "W": #First Wave Delay
            z_new[17] = 2
        if z_new[13] == 5: #0 LS after Cloud Nine; First Wave Delay doesnt matter here
            z_new[17] = 1
    
    if z_new[14] < 2:
        z_new[14] += 1
    
    
        
    return(z_new)

def Win_P(S): # Die Wahrscheinlichkeiten stehen hier drinnen, d.h. man kann P mit einem geeigneten Faktor multiplizieren um die 10^{-10} werte wegzubekommen.
    P = 100
    for x in range(2,len(S)):
        P = P*S[x][0]
    return(P)


WINCOUNT = [0 for _ in range(30)]
DEATHCOUNT = [0 for _ in range(30)]
TOLONGCOUNT = [0 for _ in range(30)]
RESULT = 0

def Rek(S,z,P,q):
    global ta
    global WINCOUNT
    global DEATHCOUNT
    global TOLONGCOUNT
    global RESULT
    if keyboard.is_pressed("F7"):
        print(q)
        print(P)
        time.sleep(1)
    if q > P[3]:
        print(100*P[3])
        print(time.time()-ta)
        print("")
        P[3] += 0.01
    k = 60
    if not z[15]:
        DEATHCOUNT[z[5]] += 1
        r = S[-1][0]
        
        if z[5] in [5,7]:
            RESULT += r
        q += r
        P[1] += r
        return(P,q)
    if z[4] < 0:
        
        WINCOUNT[z[5]] += 1
        r = S[-1][0]
        q += r
        P[0] += r
        return(P,q)
    if len(S) > k:
        TOLONGCOUNT[z[5]] += 1
        r = S[-1][0]
        q += r
        P[2] += r
        return(P,q)
    Q = [s for s in S]
    if z[14] == 0:
        R = Action_Mario(z)
        for x in R:
            Q.append([x[0]*Q[-1][0],x[1]])
            P,q = Rek(Q,Stat_Change(Q,z),P,q)
            Q.pop(-1)
        
    elif z[14] == 1:
        R = Action_Partner(z)
        for x in R:
            Q.append([x[0]*Q[-1][0],x[1]])
            P,q = Rek(Q,Stat_Change(Q,z),P,q)
            Q.pop(-1)
            
    elif z[14] == 2:
        R_1 = Action_Bowser(z)
        R_2 = Action_Inbetween(z)
        for x in R_1:
            Q.append([x[0]*Q[-1][0],x[1]])
            for y in R_2:
                Q.append([y[0]*Q[-1][0],y[1]])
                P,q = Rek(Q,Stat_Change(Q,z),P,q)
                Q.pop(-1)
            Q.pop(-1)
    return(P,q)

def Proj(S,z,P,q,i):
    print(Rek(S,z,P,q),5-i)
    return()

