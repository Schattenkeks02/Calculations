void Rek(int length, double S[k+4][2], int z[18]){

        while(q > P[3]){
            printf("%.2f\n",q);
            P[3] += 0.01;
        }

        double r = 0;

        if(z[15] == 0){
            r = S[length][0];
            q += r;
            P[1] += r;
            Chances[1][z[5]] += r;
            return;
        }

        if(length > k-1){
            r = S[length][0];
            q += r;
            P[2] += r;
            Chances[2][z[5]] += r;
            return;
        }

        if(z[4] < 1){
            r = S[length][0];
            q += r;
            P[0] += r;
            Chances[0][z[5]] += r;
            return;
        }

        double A[6][2] = {{0}};


        // Marios Turn

        if(z[14] == 0){
            int L = Action_Mario(A,z)+1;
            for(int x = 0; x < L;x++){
                S[length+1][0] = S[length][0]*A[x][0];
                S[length+1][1] = A[x][1];
                int y[18] = {0};
                Stat_Change(length+1,S,z,y);
                Rek(length+1,S,y);
            }
        }
        else{ // Partners Turn

            if(z[14] == 1){
                int L = Action_Partner(A,z)+1;
            for(int x = 0; x < L;x++){
                S[length+1][0] = S[length][0]*A[x][0];
                S[length+1][1] = A[x][1];
                int y[18] = {0};
                Stat_Change(length+1,S,z,y);
                Rek(length+1,S,y);
            }


        }
        else{ //Bowser + Inbetween Turn
                double B[6][2] = {{0}};

            if(z[14] == 2){
                int L = Action_Bowser(A,z)+1;
            for(int x = 0; x < L;x++){
                S[length+1][0] = S[length][0]*A[x][0];
                S[length+1][1] = A[x][1];
                int M = Action_Inbetween(B,z)+1;
                for(int w = 0; w < M;w++){
                    S[length+2][0] = S[length+1][0]*B[w][0];
                    S[length+2][1] = B[w][1];
                    int y[18] = {0};
                    Stat_Change(length+2,S,z,y);
                    Rek(length+2,S,y);
                }



        }





}

        }
        }
        return;
}



