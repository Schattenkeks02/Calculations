int Action_Bowser(double A[6][2],int z[18]){
    int LengthA = -1;

    double Prob = 1;
    // Heal?
    if(10*z[0] - (100.0/99.0)*z[4] >= 25){
        LengthA += 1;
        A[LengthA][1] = 1;
        A[LengthA][0] = Prob*0.75;
        Prob *= 0.25;
    }
    // Shield?
    if (z[8] == 0){
        // Turn 3 Shield?
        if (z[9] == 3){
            LengthA += 1;
            A[LengthA][1] = 2;
            A[LengthA][0] = Prob*0.15;
            Prob *= 0.85;
        }
        else{
            // Turn >3 Shield?
            if(z[9] > 3){
                LengthA += 1;
            A[LengthA][1] = 2;
            A[LengthA][0] = Prob*0.75;
            Prob *= 0.25;
            }
        }
    }
    // Turn < 3?
    if (z[5] < 3){
        LengthA += 1;
        A[LengthA][1] = 3;
        A[LengthA][0] = 1;
        return(LengthA);
    }
    // Pre Wave
    if(z[10] < 3){
        if(z[16] == 1 || z[5]> 5){
            if(z[12] > 1){
                LengthA += 1;
                A[LengthA][1] = 6;
                A[LengthA][0] = Prob*0.25;
                Prob *= 0.75;
            }
            if(z[11] > 1){
                LengthA += 1;
                A[LengthA][1] = 5;
                A[LengthA][0] = Prob*(1.0/3.0);
                Prob *= 2.0/3.0;
            }
            LengthA += 1;
            A[LengthA][1] = 3;
            A[LengthA][0] = Prob;
            return LengthA;
        }
        else{
            LengthA += 1;
            A[LengthA][1] = 3;
            A[LengthA][0] = 1;
            return LengthA;
        }
    }

    // Long Wave Delay
    if(z[10]> 5){
        LengthA += 2;
        A[LengthA-1][0] = Prob*(2.0/3.0);
        A[LengthA-1][1] = 4;
        A[LengthA][0] = Prob*(1.0/3.0);
        A[LengthA][1] = 3;
        return LengthA;
    }
    // Charged Wave priority
    if(z[1] == 1){
        LengthA += 1;
        A[LengthA][0] = Prob*0.795;
        A[LengthA][1] = 4;
        Prob *= 0.25;
    }
    else{
        LengthA += 1;
        A[LengthA][0] = Prob*0.18;
        A[LengthA][1] = 4;
    }
    if(z[16] == 1 || z[5]> 8){
            double p = Prob*0.09;
            Prob *= 0.73;
            if(z[12] > 1){
                LengthA += 1;
                A[LengthA][1] = 6;
                A[LengthA][0] = Prob*0.25;
                Prob *= 0.75;
            }
            if(z[11] > 1){
                LengthA += 1;
                A[LengthA][1] = 5;
                A[LengthA][0] = Prob*(1.0/3.0);
                Prob *= 2.0/3.0;
            }
            LengthA += 1;
            A[LengthA][1] = 3;
            A[LengthA][0] = Prob+p;
            return LengthA;
        }
        else{
            LengthA += 1;
            A[LengthA][1] = 3;
            A[LengthA][0] = Prob*0.82;
            return LengthA;
        }

    }


